# Puerto del API
PORT=4000

# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mi-banco-monetario
# Con Atlas, pega la cadena del botón "Connect" y AGRÉGALE el nombre de la base
# antes del "?": sin él Mongo escribe en "test" y no encuentras tus datos.
# Atlas también exige tener tu IP en Network Access, o la conexión expira.
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/mi-banco-monetario?retryWrites=true&w=majority

# Secreto para firmar los JWT. CÁMBIALO en producción.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=30d

# Orígenes permitidos por CORS, separados por coma.
# En desarrollo se permite además cualquier IP de la red local (para probar en el celular).
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# --- Chat de Nivis (Gemini) -------------------------------------------------
# OPCIONAL. Sin llave la app funciona igual: el chat sigue abriéndose y Nivis
# responde con el plan que calcula el servidor con tus números. Con llave,
# además, puedes platicar con él.
# Consigue una gratis en https://aistudio.google.com/apikey
# NUNCA la escribas aquí: este archivo SÍ se sube al repo. Va en server/.env.
GEMINI_API_KEY=
# Modelo a usar. El alias -latest sigue apuntando al flash más reciente.
GEMINI_MODEL=gemini-flash-latest
# Los flash actuales razonan antes de contestar y esos tokens salen de este
# mismo tope: con 900 el modelo se queda sin presupuesto ANTES de escribir una
# palabra y devuelve MAX_TOKENS vacío. 2500 deja margen de sobra.
GEMINI_MAX_TOKENS=2500
# Solo si necesitas otra versión del API o un proxy.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=25000

# --- Lectura de tickets con la cámara ---------------------------------------
# Usa la MISMA GEMINI_API_KEY de arriba. Sin llave, el botón de la cámara
# responde con un aviso y el usuario anota el gasto a mano como siempre.
#
# Tope del archivo. 4.5 MB es el límite de cuerpo de las funciones serverless
# donde suele vivir este API: más arriba, la petición muere antes de llegar.
TICKET_MAX_BYTES=4718592
# Leer una foto tarda más que contestar un mensaje: la imagen viaja completa.
TICKET_TIMEOUT_MS=45000
TICKET_MAX_TOKENS=2500
